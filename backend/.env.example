# Groq API key (chat completions — interview Q&A, Clash AI question generation)
GROQ_API_KEY=

# Currents API key (news proxy — actively used)
CURRENTS_API_KEY=

# JSearch (RapidAPI) key (jobs proxy)
JSEARCH_API_KEY=

# Shared secret the jobs-prewarm cron job (GitHub Actions) presents to
# POST /internal/prewarm-jobs so that endpoint isn't callable by anyone else.
PREWARM_SECRET=

# Firebase project id — used mainly for local/dev clarity; the Admin SDK
# infers this from credentials in most cases, but some environments
# (emulator, ADC without a project hint) need it set explicitly.
FIREBASE_PROJECT_ID=myproject-a48d7

# Path to a service account JSON key file. Required for local development
# unless you're using `gcloud auth application-default login` (which writes
# credentials firebase-admin picks up automatically). NOT needed on Cloud Run
# itself — the platform's attached service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# Set to "true" to enable verbose upstream request/response logging
# (Groq/Currents raw payloads). Leave unset/false in production.
DEBUG=
